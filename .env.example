# Copy this file to .env.local and fill in the values.
# Find Supabase ones in your Supabase project: Connect (top bar), or Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "publishable" key (starts with sb_publishable_). The older "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Email notifications (new request, request accepted, weekly digest, daily approval reminder) ---

# Settings > API Keys > "service_role" / secret key. Server-only: never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# SMTP credentials for the account that sends notification emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=xxx
EMAIL_FROM=you@example.com

# Where the app is reachable. Used to build links inside emails.
APP_URL=http://localhost:3000

# Shared secret between the Postgres webhook (supabase/notifications.sql) and
# app/api/notify. Generate with: openssl rand -hex 32
NOTIFY_WEBHOOK_SECRET=xxx

# Checked by the cron routes (app/api/cron/*). Vercel sets the matching
# Authorization header automatically for Cron Jobs defined in vercel.json.
# Generate with: openssl rand -hex 32
CRON_SECRET=xxx
